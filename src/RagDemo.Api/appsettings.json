{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "Data": {
    "InputFile": "../../data/raw/company-info.txt",
    "InputFolder": "../../data/raw",
    "OutputFolder": "../../data/processed",
    "PdfDirectory": "../../data/raw/pdf"
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text",
    "ChatModel": "gemma2:2b"
  },
  "Retrieval": {
    "TopK": 5,
    "MinimumSimilarity": 0.55,
    "ConfidenceGap": 0.036,
    "SearchLimit": 10
  },
  "Chunking": {
    "ChunkSize": 1000,
    "Overlap": 200
  },
  "Embeddings": {
    "MaxConcurrency": 8
  },
  "Qdrant": {
    "BaseUrl": "http://localhost:6334",
    "CollectionName": "ragdemo-documents",
    "VectorSize": 768
  },
  "Conversation": {
    "MaxHistoryTurns": 4
  },
  "Evaluation": {
    "DatasetPath": "../../data/evaluation/evaluation-dataset.json"
  },
  "Ai": {
    "DefaultProvider": "local",

    "Providers": {
      "local": {
        "Type": "Ollama",
        "BaseUrl": "http://localhost:11434",
        "ChatModel": "gemma2:2b",
        "EmbeddingModel": "nomic-embed-text"
      },

      "groq": {
        "Type": "groq",
        "BaseUrl": "https://api.groq.com/openai/v1/",
        "ApiKey": "",
        "ChatModel": "openai/gpt-oss-120b",

        "MaxRetryAttempts": 3,
        "RetryDelaySeconds": 15
      },

      "gemini": {
        "Type": "Gemini",
        "ApiKey": "",
        "ChatModel": "gemini-2.5-pro"
      }
    }
  }
}